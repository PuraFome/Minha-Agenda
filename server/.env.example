# =============================================================================
# Minha-Agenda — Backend environment template (COMMITTED, NO SECRETS)
# -----------------------------------------------------------------------------
# Copy this file to `server/.env` and fill in real values. `server/.env` is
# gitignored and MUST NEVER be committed. This `.env.example` is only a template
# with empty/placeholder values so the schema is tracked in version control.
#
# How to use:
#   1. cp server/.env.example server/.env
#   2. Fill the values below from your CockroachDB Cloud account and Google
#      Cloud Console.
#   3. Never commit server/.env (a pre-commit hook blocks DATABASE_URL /
#      GOOGLE_CLIENT_SECRET / SESSION_SECRET from being staged).
#
# Key reference:
#   DATABASE_URL        CockroachDB Cloud connection string.
#                       Format: postgresql://<user>:<password>@<host>:<port>/<db>?sslmode=verify-full
#                       REQUIRED: sslmode=verify-full (CockroachDB Cloud mandates TLS).
#                       Example: postgresql://root@free-tier.gcp-us-central1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
#
#   GOOGLE_CLIENT_ID    Google Cloud OAuth 2.0 "Web application" client ID.
#                       Create at: Google Cloud Console → APIs & Services →
#                       Credentials → OAuth 2.0 Client ID (type: Web application).
#                       Used for Google Sign-In (PKCE + state + nonce).
#
#   GOOGLE_CLIENT_SECRET Google Cloud OAuth 2.0 "Web application" client secret
#                       (paired with GOOGLE_CLIENT_ID). Keep secret; never expose
#                       to the frontend or commit it.
#
#   SESSION_SECRET      Long, random string used to sign the express-session
#                       cookie. Generate e.g. with: openssl rand -base64 48
#                       Use a different value per environment.
#
#   API_PORT            Port the backend listens on (default 3000).
#
#   API_PUBLIC_URL      Public base URL of the API (used in OAuth redirects /
#                       CORS / links). Example: https://api.<yourdomain.com>
#
#   FRONTEND_ORIGIN     Allowed CORS origin of the frontend (GitHub Pages).
#                       Example: https://<user>.github.io
#                       In development also http://localhost:4200 is allowed.
#
#   FRONTEND_REDIRECT_URL  Optional. Post-login redirect target when the SPA
#                       is served under a sub-path (GitHub Pages project sites,
#                       e.g. https://<user>.github.io/<repo>/). CORS must keep
#                       matching the bare origin, so this carries the base path.
#                       Falls back to FRONTEND_ORIGIN when unset.
#                       Example: https://<user>.github.io/Minha-Agenda/
#
#   NODE_ENV            Runtime mode: development | production.
#                       In production the session cookie is secure + sameSite
#                       'none'; in development it is lax + insecure.
#
#   ALLOW_DEV_LOGIN     DEV-ONLY mock-login flag for automated cross-device
#                       Playwright QA. When set to 'true' AND NODE_ENV is NOT
#                       'production', GET /api/auth/dev-login logs the browser
#                       in as a FIXED dev user (sub 'dev-user-local') and
#                       redirects to FRONTEND_ORIGIN — no interactive Google
#                       login required. When unset/false, or in production, the
#                       endpoint returns 404 (invisible/disabled).
#                       ⚠ NEVER set this to 'true' in production — it is an auth
#                       bypass. Default: unset (=false).
# =============================================================================

DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
API_PORT=3000
API_PUBLIC_URL=
FRONTEND_ORIGIN=
# FRONTEND_REDIRECT_URL=
NODE_ENV=development
# ALLOW_DEV_LOGIN=true
